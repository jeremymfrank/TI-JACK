<?xml version="1.0" encoding="utf-8"?>
<com.tijack.evo.SafeAreaLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TI-JACK"
            android:textColor="@color/amber"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <com.tijack.evo.HelpButton
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end|center_vertical"
            android:text="?"
            android:contentDescription="Help and about"
            android:textColor="@color/amber"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </FrameLayout>

    <TextView
        android:id="@+id/connectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● SEARCHING..."
        android:textColor="@color/amber"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/operationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEARCHING..."
        android:textColor="@color/amber"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="2dp" />

    <com.tijack.evo.FriendlyDiagnosticTextView
        android:id="@+id/diagnostic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/amber_dim"
        android:textSize="9sp"
        android:gravity="center"
        android:maxLines="3"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANDROID"
                android:textColor="@color/amber"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/computerFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NO FOLDER SELECTED"
                android:textColor="@color/amber_dim"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="middle" />
        </LinearLayout>

        <Button
            android:id="@+id/chooseFolder"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="CHOOSE FOLDER"
            android:textSize="9sp"
            android:textColor="@color/bg"
            android:backgroundTint="@color/amber"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.40"
        android:fillViewport="true"
        android:background="@color/panel">

        <LinearLayout
            android:id="@+id/computerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/androidSelectAll"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:text="SELECT ALL"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/bg"
            android:backgroundTint="@color/amber"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/androidClearSelection"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="CLEAR"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/bg"
            android:backgroundTint="@color/amber"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/deleteAndroidSelected"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="DELETE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/bg"
            android:backgroundTint="@color/red"
            android:minHeight="0dp"
            android:minWidth="0dp" />
    </LinearLayout>

    <com.tijack.evo.TransmitButton
        android:id="@+id/sendSelected"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:text="TRANSMIT SELECTED →"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/bg"
        android:backgroundTint="@color/amber"
        android:minHeight="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CALCULATOR"
                android:textColor="@color/amber"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/calculatorMemoryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EST FREE · RAM -- · ARC --"
                android:textColor="@color/amber_dim"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:text="SIZE"
            android:textColor="@color/amber"
            android:textStyle="bold"
            android:textSize="10sp"
            android:gravity="end" />

        <TextView
            android:layout_width="43dp"
            android:layout_height="wrap_content"
            android:text="MEM"
            android:textColor="@color/amber"
            android:textStyle="bold"
            android:textSize="10sp"
            android:gravity="end" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.60"
        android:fillViewport="true"
        android:background="@color/panel">

        <LinearLayout
            android:id="@+id/calculatorList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/calculatorSelectAll"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:text="SELECT ALL"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/bg"
            android:backgroundTint="@color/amber"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/calculatorClearSelection"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="CLEAR"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/bg"
            android:backgroundTint="@color/amber"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/deleteCalculatorSelected"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="DELETE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/bg"
            android:backgroundTint="@color/red"
            android:minHeight="0dp"
            android:minWidth="0dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/archiveCalculatorSelected"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:text="ARCHIVE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/bg"
            android:backgroundTint="@color/amber"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/unarchiveCalculatorSelected"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="RAM"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/bg"
            android:backgroundTint="@color/amber"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/cleanupGifMedia"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="CLEAN GIF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/bg"
            android:backgroundTint="@color/amber"
            android:minHeight="0dp"
            android:minWidth="0dp" />
    </LinearLayout>

    <com.tijack.evo.TransmitButton
        android:id="@+id/saveSelected"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:text="← TRANSMIT SELECTED"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/bg"
        android:backgroundTint="@color/amber"
        android:minHeight="0dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SCHOOL PROPERTY"
        android:textColor="@color/amber_dim"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="4dp" />

</com.tijack.evo.SafeAreaLinearLayout>
