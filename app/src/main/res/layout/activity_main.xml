<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TI-JACK"
        android:textColor="@color/amber"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EVO / ANDROID TRANSFER TEST 0.8"
        android:textColor="@color/amber_dim"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/connectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● SEARCHING..."
        android:textColor="@color/amber"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/operationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEARCHING..."
        android:textColor="@color/amber"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/diagnostic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/amber_dim"
        android:textSize="9sp"
        android:gravity="center"
        android:maxLines="3"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="5dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TAP FILES TO SELECT · USE BUTTONS TO TRANSFER SELECTION"
        android:textColor="@color/amber_dim"
        android:textSize="8sp"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANDROID"
                android:textColor="@color/amber"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/computerFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NO FOLDER SELECTED"
                android:textColor="@color/amber_dim"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="middle" />
        </LinearLayout>

        <Button
            android:id="@+id/chooseFolder"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="CHOOSE FOLDER"
            android:textSize="9sp"
            android:textColor="@color/bg"
            android:backgroundTint="@color/amber"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.40"
        android:fillViewport="true"
        android:background="@color/panel">

        <LinearLayout
            android:id="@+id/computerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </ScrollView>

    <Button
        android:id="@+id/sendSelected"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:text="SEND SELECTED →"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/bg"
        android:backgroundTint="@color/amber"
        android:minHeight="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="3dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CALCULATOR"
            android:textColor="@color/amber"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:text="SIZE"
            android:textColor="@color/amber"
            android:textStyle="bold"
            android:textSize="10sp"
            android:gravity="end" />

        <TextView
            android:layout_width="43dp"
            android:layout_height="wrap_content"
            android:text="MEM"
            android:textColor="@color/amber"
            android:textStyle="bold"
            android:textSize="10sp"
            android:gravity="end" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.60"
        android:fillViewport="true"
        android:background="@color/panel">

        <LinearLayout
            android:id="@+id/calculatorList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </ScrollView>

    <Button
        android:id="@+id/saveSelected"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:text="← SAVE SELECTED"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/bg"
        android:backgroundTint="@color/amber"
        android:minHeight="0dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SCHOOL PROPERTY"
        android:textColor="@color/amber_dim"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="4dp" />

</LinearLayout>
